// Cron-Worker: stößt alle 5 Minuten den GitHub-Workflow „Live-Daten“ an.
// Deploy: cd trigger && npx wrangler deploy ; Secret: npx wrangler secret put GH_TOKEN
{
  "name": "stau-info-trigger",
  "main": "index.js",
  "compatibility_date": "2026-10-06",
  "triggers": { "crons": ["*/5 * * * *"] },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
